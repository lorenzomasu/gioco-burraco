{
  "name": "gioco-burraco",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:ios-spike": "vite --mode ios-spike",
    "build:ios-spike": "tsc -b && vite build --mode ios-spike",
    "ios:sync": "npm run build:ios-spike && cap sync ios",
    "ios:open": "cap open ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm test && npm run test:e2e && git diff --check",
    "smoke:deployed": "node scripts/deployed-smoke.mjs"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
